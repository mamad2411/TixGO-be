# Backend env — salin ke .env (docs/13-CONFIG-DEPLOY-TESTING.md §2). JANGAN commit .env.
APP_ENV=dev
HTTP_ADDR=:8081
LOG_LEVEL=info
DATABASE_URL=postgres://tixgo:tixgo@localhost:5433/tixgo?sslmode=disable
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
CORS_ORIGINS=http://localhost:5174
# Kosongkan bila API tidak di belakang reverse proxy (Gin default percaya semua proxy = berisiko).
TRUSTED_PROXIES=

# WAJIB — generate acak: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# WAJIB — 64 karakter hex: openssl rand -hex 32
ENC_KEY=

# Object storage (MinIO dev; kredensial sama dengan docker-compose.dev.yml)
S3_ENDPOINT=localhost:9100
S3_BUCKET=tixgo
S3_ACCESS_KEY=tixgo
S3_SECRET_KEY=tixgo-dev-123
S3_USE_SSL=false

# (Catatan lama "belum dibaca config" sudah tidak berlaku — semua dibaca; lihat blok di akhir berkas.)
# MIDTRANS_SERVER_KEY= MIDTRANS_CLIENT_KEY= MIDTRANS_ENV=sandbox
# QUEUE_ADMIT_RATE=50 QUEUE_ADMIT_WINDOW_SEC=600 QUEUE_PRE_OPEN_MIN=30
# HOLD_TTL_SEC=600 TICKET_QR_STEP_SEC=30

# --- Ditambahkan saat implementasi backend ---
WORKER_CONCURRENCY=20
TICKET_MAX_TRANSFERS=3
PAYOUT_MIN_AMOUNT=50000
PRIVACY_CONTACT_EMAIL=privasi@tixgo.local
RETENTION_NOTIFICATIONS_DAYS=180
# Hanya untuk dev/tes: izinkan webhook organizer ke alamat privat/http. DIABAIKAN saat APP_ENV=production.
WEBHOOK_ALLOW_PRIVATE=false

# Gateway pembayaran: midtrans (default) atau fake (SIMULASI; dilarang di production). Dengan fake, bayar lewat POST /api/v1/dev/payments/settle {order_id}.
PAYMENT_GATEWAY=midtrans
# Hanya uji beban di non-production: matikan rate limit (dilarang di production)
RATE_LIMIT_DISABLED=false

# /metrics dilindungi bearer token; WAJIB di production
METRICS_TOKEN=

# Xendit (Invoice API). Callback token: dashboard → Settings → Webhooks. PAYMENT_GATEWAY=xendit untuk mengaktifkan.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# --- Env lain yang dibaca config.go (default dari kode; dibangkitkan dari config.go — nilai kosong = tanpa default) ---
